digraph autonomy_light {
  rankdir=LR;
  graph [fontname="Arial", bgcolor="white", pad="0.25"];
  node [fontname="Arial", shape=box, style="rounded,filled", color="#24527a",
        fillcolor="#edf5fb", margin="0.16,0.10"];
  edge [fontname="Arial", color="#4d6b82", arrowsize="0.7"];

  livox [label="Livox driver\n(external ROS node)", fillcolor="#f5f7fa"];
  lio [label="Super-LIO\nLIO | full SLAM | relocation\nmap -> odom -> imu", fillcolor="#e9f6ee", color="#32734d"];
  d435 [label="D435 / D435i\nrealsense2_camera PointCloud2", fillcolor="#f5f7fa"];
  mapper [label="elevation_mapping\nvendored ETH/ANYbotics node\nrobot-centric circular GridMap\nvariance + visibility cleanup",
          fillcolor="#fff4df", color="#a65e00", penwidth="2"];
  control [label="Controller / Isaac Lab\nGridMap consumer", fillcolor="#f5f7fa"];
  rviz [label="GridMap viewer / RViz", fillcolor="#f5f7fa"];
  prior [label="Optional prebuilt terrain\nGridMap elevation layer", fillcolor="#f5f7fa"];

  livox -> lio [label="Livox CustomMsg + IMU"];
  lio -> mapper [label="/lio/odom covariance\n/lio/cloud_world\nmap -> odom -> imu TF"];
  d435 -> mapper [label="depth/color/points\ncalibrated TF"];
  prior -> mapper [label="underlying_map_topic", style=dashed];
  mapper -> control [label="/autonomy_light/elevation_map\ngrid_map_msgs/GridMap"];
  mapper -> rviz [label="same native GridMap"];
}
