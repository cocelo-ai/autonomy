digraph autonomy_light {
  rankdir=LR;
  graph [fontname="Arial", bgcolor="white", pad="0.25"];
  node [fontname="Arial", shape=box, style="rounded,filled", fillcolor="#edf5fb"];

  livox [label="Livox"];
  lio [label="Super-LIO\nfull SLAM 50 Hz\nmap -> odom -> lidar_link", fillcolor="#e9f6ee"];
  occupancy [label="live_occupancy_mapper\n/map + obstacle clouds", fillcolor="#e9f6ee"];
  nav2 [label="Nav2\nplanner + controller", fillcolor="#e9f6ee"];
  command [label="command_user_bridge\ncore/msg/CommandCore", fillcolor="#e9f6ee"];
  tf [label="static sensor TF + gravity frame\nlidar_link -> base_link -> F_camera_link\nbase_link -> base_link_gravity", fillcolor="#fff4df"];
  camera [label="F4 front D435\nUSB 2-1.3"];
  mapper [label="camera_frame_mapper\nraw cloud -> map", fillcolor="#fff4df"];
  merge [label="observation_merge\nmap -> base_link_gravity", fillcolor="#fff4df"];
  elevation [label="precise_elevation_mapping\nlatest grid @ 50 Hz", fillcolor="#fff4df"];
  height [label="height_map_bridge", fillcolor="#fff4df"];
  height_consumer [label="DDS height-map consumer", fillcolor="#fff4df"];

  livox -> lio [label="LiDAR + IMU"];
  lio -> occupancy [label="/lio/cloud_world"];
  occupancy -> nav2 [label="/map + obstacle clouds"];
  nav2 -> command [label="/nav2/cmd_vel\ngeometry_msgs/Twist"];
  command -> consumer [label="/control_command/autopilot\ncore/msg/CommandCore"];
  lio -> tf [label="map/base attitude TF"];
  tf -> mapper [label="static sensor TF"];
  tf -> merge [label="base_link_gravity TF"];
  camera -> mapper [label="PointCloud2"];
  mapper -> merge [label="map cloud"];
  merge -> elevation [label="camera observation"];
  elevation -> height [label="GridMap"];
  height -> height_consumer [label="DDS domain 1 / height_map\ncore_dds::HeightMap"];
}
