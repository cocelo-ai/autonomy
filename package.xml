<?xml version="1.0"?>
<package format="3">
  <name>autonomy_light</name>
  <version>0.6.0</version>
  <description>Bringup for Livox, Super-LIO, and vendored robot-centric elevation mapping.</description>
  <maintainer email="todo@example.com">autonomy_light maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>grid_map_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <build_depend>cyclonedds</build_depend>
  <exec_depend>cyclonedds</exec_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>elevation_mapping</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>super_lio</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
